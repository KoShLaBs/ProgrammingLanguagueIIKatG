sequenceDiagram
    participant Usuario
    participant App
    participant Menu
    participant Validar
    participant Ahorros

    Usuario->>App: iniciar()
    App->>Menu: menuPrincipal()
    Menu-->>App: muestra opciones
    App->>Validar: validarOpcion("0 y 2")
    Validar-->>App: opcion

    alt opcion == 1 (Metas)
        App->>Menu: menuMetas()
        Menu-->>App: muestra submenu metas
        App->>Validar: validarOpcion("0 y 5")
        Validar-->>App: opcionMetas
        alt Agregar Meta
            App->>Validar: descripcionMeta(...)
            Validar-->>App: descripcion
            App->>Validar: validarMonto(...)
            Validar-->>App: monto
            App->>Validar: validarIcono(...)
            Validar-->>App: icono
            App->>Ahorros: crearMeta(descripcion,monto,icono)
            Ahorros-->>App: confirmacion
        else Mostrar/Editar/Eliminar/Agregar monto
            App->>Ahorros: mostrarMetas() / actualizarMeta() / eliminarMeta() / agregarMontoAMeta()
            Ahorros-->>App: resultados / mensajes
        end

    else opcion == 2 (Cuentas)
        App->>Menu: menuCuentas()
        Menu-->>App: muestra submenu cuentas
        App->>Validar: validarOpcion("0 y 4")
        Validar-->>App: opcionCuenta
        alt Agregar Cuenta
            App->>Validar: validarMonto(...) / descripcionMeta(...)
            Validar-->>App: datos
            App->>Ahorros: crearCuenta(...)
            Ahorros-->>App: confirmacion
        else Mostrar/Actualizar/Eliminar
            App->>Ahorros: mostrarCuentas() / actualizarCuenta() / eliminarCuenta()
            Ahorros-->>App: resultados / mensajes
        end
    end

    loop hasta opcion == 0
        App->>Validar: validarOpcion(...)
    end
    Usuario->>App: salir
    App-->>Usuario: termina
